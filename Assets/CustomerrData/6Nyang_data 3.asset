  toppingItemSpriteForHint: {fileID: 21300000, guid: 6654442cccd5a6e4ea8dc5f38f632e89, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: ec7019a8afcac2f479ea5d8f7acd9e1a, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: 8eac4207b71a6a54cb73cabd79ee67d2, type: 3}
  skewerWithToppingSprite: {fileID: 21300000, guid: e60288189ea10564db7c669e634afc08, type: 3}
  dialogueSequence:
  - speaker: 0
    line: " \u2026\uC5EC\uAE30\uC600\uAD6C\uB098. \uC624\uB298 \uC810\uC2EC\uC5D0
      \uB07C\uB07C \uD478\uD478\uAC00 \uAC00\uAC8C\uB97C \uC5F4\uC5C8\uB2E4\uBA70
      \uC2E0\uC774 \uB098 \uB5A0\uB4DC\uB294 \uAC78 \uB4E3\uACE0 \uB9D0\uC558\uC9C0.
      \uBB3C\uB860 \uD3C9\uC18C\uB77C\uBA74 \uC62C \uC77C\uC774 \uC5C6\uACA0\uC9C0\uB9CC.
      \uAD1C\uD788 \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uB294 \uAC8C \uC788\uC5B4\uC11C,
      \uD07C\uD07C."
  - speaker: 1
    line: "\uC640\uC544, \uB0E5\uB0E5\uC774 \uB124\uAC00 \uC62C \uC904\uC740 \uBAB0\uB790\uC5B4!
      \uD559\uC0DD\uD68C \uC77C\uB85C \uBC14\uC060 \uD150\uB370\u2026 \uACE0\uB9D9\uB2E4.(\uB07C\uB07C\uAC00
      \uD64D\uBCF4\uB97C \uC81C\uB300\uB85C \uD574\uC8FC\uACE0 \uC788\uAD6C\uB098!)"
  - speaker: 0
    line: "\uBB50, \uD559\uC0DD\uC774 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD55C\uB2E4\uB294\uB370
      \uD559\uC0DD\uD68C\uC7A5\uC73C\uB85C\uC11C \uD655\uC778\uD558\uC9C0 \uC54A\uC744
      \uC21C \uC5C6\uC73C\uB2C8\uAE4C."
  - speaker: 0
    line: "\uBB50, \uD559\uC0DD\uC774 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD55C\uB2E4\uB294\uB370
      \uD559\uC0DD\uD68C\uC7A5\uC73C\uB85C\uC11C \uD655\uC778\uD558\uC9C0 \uC54A\uC744
      \uC21C \uC5C6\uC73C\uB2C8\uAE4C."
  - speaker: 1
    line: "\uADF8\uB7F0\uAC00, \uD558\uD558. \uC624\uB298 \uBB50 \uBA39\uC744\uB798?"
  - speaker: 0
    line: "\uC74C\u2026 \uC0AC\uC2E4, \uC774\uB7F0 \uB2F9\uB3C4 \uB192\uC740 \uAC04\uC2DD\uC740
      \uAC74\uAC15\uC5D0 \uADF8\uB2E4\uC9C0 \uC88B\uC9C0 \uC54A\uC544. \uC124\uD0D5\uC740
      \uD558\uB8E8 \uC12D\uCDE8\uB7C9\uC774 \uC815\uD574\uC838 \uC788\uACE0, \uD608\uB2F9\uB3C4
      \uC62C\uB77C\uAC00\uAE30 \uC27D\uC9C0. \uAC8C\uB2E4\uAC00 \uC694\uC998\uC740
      \uC2DC\uD5D8 \uAE30\uAC04\uC774\uB77C \uBB34\uC5C7\uBCF4\uB2E4 \uAC74\uAC15\uC774
      \uC911\uC694\uD55C \uAE30\uAC04\uC774\uACE0\u2026\r\n"
  - speaker: 1
    line: "\uD558\uD558, \uADF8\uB798\uB3C4 \uD55C \uBC88 \uCBE4\uC740 \uAD1C\uCC2E\uC9C0
      \uC54A\uC544? \uD3C9\uC18C\uC5D0 \uC798 \uCC59\uACA8 \uBA39\uB294 \uB0E5\uB0E5\uC774\uB2C8\uAE4C,
      \uC624\uB298 \uD558\uB8E8\uB294 \uBCF4\uC0C1\uC774\uB77C\uACE0 \uC0DD\uAC01\uD574
      \uBD10! \uB2F9 \uCDA9\uC804\uC740 \uACF5\uBD80\uD558\uB294\uB370 \uB3C4\uC6C0\uC774
      \uB418\uAE30\uB3C4 \uD558\uB2C8\uAE4C. \uACFC\uC77C\uB3C4 \uC788\uC5B4\uC11C
      \uBE44\uD0C0\uBBFC \uCDA9\uC804\uB3C4 \uB418\uACE0!"
  - speaker: 0
    line: "\u2026 \u2026\uB124\uAC00 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uB9D0\uD55C\uB2E4\uBA74\uC57C.
      \uC88B\uC544."
  - speaker: 0
    line: "\uB09C \uD1A0\uB9C8\uD1A0, \uC0E4\uC778\uBA38\uC2A4\uCF13, \uCCB4\uB9AC,
      \uADF8\uB9AC\uACE0 \uB2E4\uC2DC \uD1A0\uB9C8\uD1A0, \uB9C8\uC9C0\uB9C9\uC740
      \uBE14\uB8E8\uBCA0\uB9AC\uB85C \uD574\uC918. \uCC38\uACE0\uB85C \uBE14\uB8E8\uBCA0\uB9AC\uB294
      \uB208\uC5D0 \uC88B\uC544. \uB108\uB3C4 \uC790\uC8FC \uBA39\uB3C4\uB85D \uD574.
      \uC544, \uADF8\uB9AC\uACE0 \uC124\uD0D5 \uCF54\uD305\uC740 \uB108\uBB34 \uB450\uAECD\uC9C0
      \uC54A\uAC8C \uBD80\uD0C1\uD574. \uC539\uC744 \uB54C \uC774 \uC0AC\uC774\uC5D0
      \uB07C\uBA74 \uADC0\uCC2E\uAC70\uB4E0."
  presentationDialogueSequence:
  - speaker: 0
    line: " \u2026!? \uC774\uAC70, \uC0DD\uAC01\uBCF4\uB2E4 \uB354 \uB9DB\uC788\uB124.
      \uC5ED\uC2DC \uBAB8\uC5D0 \uAC74\uAC15\uD55C \uACFC\uC77C\uC774 \uC788\uC5B4\uC11C
      \uADF8\uB7F0\uAC00. \uCF54\uD305\uC740 \uC587\uACE0 \uBC14\uC0AD\uD574\uC11C
      \uC2DD\uAC10\uB3C4 \uC88B\uACE0\u2026 \uB9C8\uC9C0\uB9C9\uC5D0 \uBE14\uB8E8\uBCA0\uB9AC\uAC00
      \uC785 \uC548\uC5D0\uC11C \uD1A1 \uD130\uC9C0\uB294 \uAC8C \uAE30\uBD84 \uC88B\uB124."
  - speaker: 1
    line: "\uB9C8\uC74C\uC5D0 \uB4E4\uC5B4? \uC88B\uC544\uD560\uC9C0 \uAC71\uC815\uD588\uB294\uB370,
      \uB2E4\uD589\uC774\uB2E4!"
  - speaker: 0
    line: "\uD07C\uD07C, \uC608\uC0C1\uBCF4\uB2E4 \uAD1C\uCC2E\uC558\uB2E4\uB294
      \uAC70\uC57C. \uB2E4\uC74C\uC5D0 \uB610 \uC624\uACA0\uB2E4\uB294 \uB9D0\uC740
      \uC548 \uD588\uC5B4. \uB2E4\uB9CC, \uC624\uB298 \uAC19\uC740 \uB0A0 \uAC04\uC2DD\uC73C\uB85C
      \uD63C\uC790 \uBA39\uAE30\uC5D4 \uC88B\uC740 \uAC83 \uAC19\uAE34 \uD558\uB124.  "
  - speaker: 0
    line: "\u2026 \u2026 \u2026 \u2026. \uB2E4\uC74C\uC5D0 \uC62C \uB54C\uB3C4 \uC774
      \uC0DD\uC120 \uAF42\uC544 \uC904 \uAC70\uC9C0?"

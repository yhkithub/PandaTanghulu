  customerName: "\uBA54\uBA54"
  customerSprite: {fileID: 21300000, guid: 5a7bc282da0975748bedeeb3a332a4f8, type: 3}
  smilingCustomerSprite: {fileID: 21300000, guid: 41fae343eeb5d254d923c2c81901564c, type: 3}
  skewerOrder:
  - fruit: 1
  - fruit: 3
  - fruit: 4
  - fruit: 5
  toppingItem: 11
  toppingItemSpriteForHint: {fileID: 21300000, guid: 610cddb75913135438670e111db1fd9d, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: 267adf008b77fa64582617e103d163bc, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: cba4c04ed10859c47a3c4468fb59087f, type: 3}
  skewerWithToppingSprite: {fileID: 21300000, guid: 18c098428ca87fa449fa9534627a627b, type: 3}
  sugarBoilingSpeed: 3
  sugarBoilingSuccessZoneWidth: 280
  dialogueSequence:
  - speaker: 0
    line: "\uD478\uD478~ \uAC00\uAC8C \uC624\uD508 \uCD95\uD558\uD574. \uC544\uCE68\uBD80\uD130
      \uC5BC\uB9C8\uB098 \uC190\uAF3D\uC544 \uAE30\uB2E4\uB838\uB294\uC9C0 \uBAB0\uB77C! 
      \uC6B0\uB9AC \uBC18 \uCE5C\uAD6C\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uC774\uC57C\uAE30\uAC00
      \uB3CC\uB358 \uAC78 \uC6B0\uC5F0\uD788 \uB4E3\uACE0, \uBC14\uB85C \uB2EC\uB824\uC654\uC9C0
      \uBB50\uC57C. \uC120\uC0DD\uB2D8\uC774 \uC81C\uC77C \uBA3C\uC800 \uC654\uC73C\uBA74
      \uC88B\uACA0\uB294\uB370, \uC5ED\uC2DC \uAC00\uC7A5 \uBE60\uB978 \uB07C\uB07C\uB97C
      \uC774\uAE38 \uC218\uB294 \uC5C6\uC5C8\uB354\uB77C."
    spriteState: 0
  - speaker: 1
    line: "\uC544, \uC120\uC0DD\uB2D8! \uC544\uB2C8\uC5D0\uC694~ \uC640\uC8FC\uC2E0
      \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uB108\uBB34 \uAC10\uC0AC\uD55C \uAC78\uC694!"
    spriteState: 0
  - speaker: 0
    line: "\uBAA8\uCC98\uB7FC \uC81C\uC790\uAC00 \uC5F4\uC2EC\uD788 \uC900\uBE44\uD55C
      \uCCAB \uAC00\uAC8C\uC778\uB370, \uC120\uC0DD\uB2D8\uC774 \uC548 \uC62C \uC218\uB294
      \uC5C6\uC9C0. \uADF8\uB098\uC800\uB098 \uC815\uB9D0 \uC608\uC058\uAC8C \uC798
      \uAFB8\uBA70\uB1A8\uB124. \uB531 \uD478\uD478\uB2E4\uC6CC! \uB530\uB73B\uD558\uACE0,
      \uC815\uC131\uC2A4\uB7FD\uACE0!"
    spriteState: 0
  - speaker: 1
    line: "\uD558\uD558\u2026 \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uAE34\uC7A5\uC774
      \uC880 \uD480\uB9AC\uB124\uC694. \uD0D5\uD6C4\uB8E8\uB294 \uC5B4\uB5A4 \uAC78\uB85C
      \uB4DC\uB9B4\uAE4C\uC694?"
    spriteState: 0
  - speaker: 0
    line: "\uC74C~ \uC120\uC0DD\uB2D8\uC740 \uB9D0\uC774\uC9C0, \uD2B9\uBCC4\uD55C
      \uAC70 \uB9D0\uACE0 \uAE30\uBD84\uC774 \uC88B\uC544\uC9C0\uB294 \uC870\uD569\uC774\uC5C8\uC73C\uBA74
      \uC88B\uACA0\uB294\uB370. \uC694\uC998 \uC2DC\uD5D8 \uC900\uBE44\uB97C \uD558\uB290\uB77C
      \uC120\uC0DD\uB2D8\uB3C4 \uAE30\uC6B4\uC774 \uC870\uAE08 \uBE60\uC84C\uB294\uB370,
      \uD478\uD478\uAC00 \uB9CC\uB4E0 \uD0D5\uD6C4\uB8E8\uB77C\uBA74 \uD798\uC774
      \uB0A0 \uAC83 \uAC19\uAC70\uB4E0! \uADF8\uB7EC\uB2C8\uAE4C~ \uC0C1\uD07C\uD55C
      \uADE4, \uD0A4\uC704, \uD30C\uC778\uC560\uD50C! \uADF8\uB9AC\uACE0 \uB2EC\uCF64\uD568\uC744
      \uC7A5\uC2DD\uD560 \uB538\uAE30\uB85C\u2026 \uB9CC\uB4E4 \uC218 \uC788\uC744\uAE4C?"
    spriteState: 0
  - speaker: 0
    line: "\uBB3C\uB860\uC774\uC8E0! \uC120\uC0DD\uB2D8 \uD798\uB0B4\uC2DC\uB77C\uACE0,
      \uC815\uC131 \uB4E4\uC5EC\uC11C \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4\uAC8C\uC694!"
    spriteState: 0
  presentationDialogueSequence:
  - speaker: 0
    line: "\uD478\uD478, \uB124\uAC00 \uC5F4\uC2EC\uD788 \uC900\uBE44\uD55C \uAC74
      \uC54C\uACE0 \uC788\uC5C8\uC9C0\uB9CC, \uB9C9\uC0C1 \uC640 \uBCF4\uB2C8\uAE4C
      \uB354 \uAC10\uB3D9\uC774\uC9C0 \uBB50\uC57C. \uD559\uAD50\uC5D0 \uC785\uD559\uD588\uC744
      \uB54C\uBD80\uD130 \uBB34\uC5B8\uAC00 \uB9CC\uB4E4 \uB550 \uAF2D \uC644\uBCBD\uD558\uAC8C
      \uB9C8\uBB34\uB9AC\uD558\uACE0 \uADF8\uB7AC\uC73C\uB2C8\uAE4C~ \uADF8 \uC131\uC2E4\uD568\uC774
      \uAC00\uAC8C \uC548\uC5D0 \uC798 \uB2F4\uACA8 \uC788\uB2E4\uACE0\uB098 \uD560\uAE4C?"
    spriteState: 0
  - speaker: 1
    line: "\uC790, \uC644\uC131\uB410\uC5B4\uC694! \uC120\uC0DD\uB2D8 \uC804\uC6A9,
      \u2018\uD798\uB0B4\uC138\uC694 \uD0D5\uD6C4\uB8E8\u2019\uC785\uB2C8\uB2E4!"
    spriteState: 0
  - speaker: 0
    line: "\uD478\uD478, \uC774\uAC70 \uC815\uB9D0 \uB9DB\uC788\uB2E4! \uC0DD\uAC01\uBCF4\uB2E4
      \uADF8\uB807\uAC8C \uB2EC\uC9C0 \uC54A\uC544\uC11C \uC88B\uC740 \uAC78! \uADE4\uC758
      \uC0B0\uB73B\uD568\uBD80\uD130 \uD0A4\uC704\uC758 \uBD80\uB4DC\uB7EC\uC6C0,
      \uB538\uAE30\uC758 \uB2EC\uCF64\uD55C \uB9DB\uAE4C\uC9C0! \uB9C8\uCE58 \uC5EC\uB984\uC744
      \uB9DB\uBCF4\uB294 \uB290\uB08C\uC774\uB124.\uB05D\uC5D0 \uC788\uB294 \uD480\uC740
      \uC120\uC0DD\uB2D8\uC744 \uC704\uD55C \uC120\uBB3C\uC778 \uAC70\uC9C0? \uB9DB\uB3C4
      \uB9DB\uC774\uC9C0\uB9CC, \uB124 \uB9C8\uC74C\uC774 \uB2F4\uACA8\uC11C \uB354
      \uB530\uB73B\uD558\uAC8C \uB290\uAEF4\uC9C0\uB294\uAD6C\uB098. \uC774\uB7F0
      \uC74C\uC2DD\uC744 \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB294 \uAC74, \uC815\uB9D0
      \uBA4B\uC9C4 \uC77C\uC774\uC57C! \uC790\uC2E0 \uC788\uAC8C \uACC4\uC18D \uB9CC\uB4E4\uC5B4\uAC00\uB834,
      \uD478\uD478. \uC120\uC0DD\uB2D8\uC740 \uC5B8\uC81C\uB098 \uC751\uC6D0\uD560\uAC8C!"
    spriteState: 0
  - speaker: 1
    line: "\uB124, \uC815\uB9D0 \uACE0\uB9D9\uC2B5\uB2C8\uB2E4. \uB354 \uC5F4\uC2EC\uD788
      \uD560\uAC8C\uC694!"
    spriteState: 0
  - speaker: 0
    line: "\uD6C4\uD6C4, \uB108\uBB34 \uC798\uD558\uB824\uACE0 \uC560\uC4F0\uC9C0
      \uC54A\uC544\uB3C4 \uB418\uB2C8\uAE4C~ \uB2E4\uC74C\uBC88\uC5D4 \uC544\uC774\uB4E4\uC774\uB791
      \uAC19\uC774 \uC640\uC57C\uACA0\uB2E4. \uADF8\uB7FC, \uC120\uC0DD\uB2D8\uC740
      \uC774\uB9CC \uAC00\uBCFC\uAC8C."
    spriteState: 0

  customerName: "\uD06C\uD06C"
  customerSprite: {fileID: 21300000, guid: db0692b713dfad04eb26d6b219045c51, type: 3}
  smilingCustomerSprite: {fileID: 21300000, guid: 8b42f443c12ac7549ba4a78011bb22cb, type: 3}
  skewerOrder:
  - fruit: 3
  - fruit: 5
  - fruit: 6
  - fruit: 7
  - fruit: 8
  toppingItem: 13
  toppingItemSpriteForHint: {fileID: 21300000, guid: 3243199b3fe2fc947843bb89719b745e, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: 13f854cc0c5262c47982715a7891fbf3, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: eff586e1c2d48d94fa79b9310883566e, type: 3}
  skewerWithToppingSprite: {fileID: 21300000, guid: cf6f838a077b5fd48bcd0d663df85e3a, type: 3}
  dialogueSequence:
  - speaker: 0
    line: "\uD6C4\uD6C4\u2026 \uC774 \uD5A5\uAE30, \uC774 \uACF5\uAE30. \uB2EC\uCF64\uD55C
      \uB0C4\uC0C8 \uBFD0\uB9CC \uC544\uB2C8\uB77C \uBB18\uD55C \uAE34\uC7A5\uAC10\uC774
      \uB3C4\uB294\uB370\u2026 \uC5ED\uC2DC \uB77C\uC774\uBC8C\uC758 \uB4F1\uC7A5\uC774\uB77C
      \uADF8\uB7F0\uAC00, \uC548 \uADF8\uB798\u2026 \uD478\uD478?"
  - speaker: 1
    line: "\uD06C\uD06C\u2026 \uB124\uAC00 \uC62C \uC904\uC740 \uBAB0\uB790\uB294\uB370.
      \uBB34\uC2A8 \uBC14\uB78C\uC774 \uBD88\uC5C8\uB300?"
  - speaker: 0
    line: "\uBB34\uC2A8 \uBC14\uB78C\uC774\uB0D0\uB2C8\uC774~ \uB09C \uADF8\uC800,
      \uC6B0\uC5F0\uD788 \uC774 \uAE38\uBAA9\uC744 \uC9C0\uB098\uAC00\uB2E4\uAC00
      \uAC00\uAC8C\uB97C \uB9C9 \uBE60\uC838\uB098\uC624\uB294 \uADC0\uC5EC\uC6B4
      \uD1A0\uB07C\uB97C \uBCF4\uACE0\u2026 \uD639\uC2DC \uD1A0\uD1A0\uAC00 \uC774\uACF3\uC744
      \uB4E4\uB838\uB358 \uAC74\uAC00\uC544? \uC5ED\uC2DC \uADF8\uB807\uB2E4\uBA74,
      \uC5B4\uCA54 \uC218 \uC5C6\uC774, \uB0B4 \uBAB8\uB3C4 \uC774\uACF3\uC73C\uB85C
      \uC2A4\uB974\uB975 \uC774\uB04C\uB9B4 \uC218 \uBC16\uC5D0 \uC5C6\uC5C8\uB2EC\uAE4C\u2026"
  - speaker: 1
    line: "\uADF8\uB798\uC11C, \uADF8 \uB9D0\uC744 \uD558\uB824\uACE0 \uC628 \uAC70\uC57C?
      \uC8FC\uBB38\uC774\uB098 \uD558\uC9C0 \uADF8\uB798."
  - speaker: 0
    line: "\uD6C4\uD6C4\u2026 \uC5ED\uC2DC \uB108\uB294 \uCC38 \uC815\uC9C1\uD574\uC11C
      \uC88B\uC544. \uADF8\uB798, \uC8FC\uBB38 \uD560\uAC8C. \uC774\uAC70 \uC774\uAC70,
      \uD1A0\uD1A0\uAC00 \uC5B4\uB5A4 \uC870\uD569\uC73C\uB85C \uBA39\uC5C8\uB294\uC9C0\uB3C4
      \uAD81\uAE08\uD55C\uB370\u2026\uB098\uB294 \uD0A4\uC704, \uB538\uAE30, \uD1A0\uB9C8\uD1A0,
      \uADF8\uB9AC\uACE0 \uC0E4\uC778\uBA38\uC2A4\uCF13\u2026 \uC624, \uB9C8\uC9C0\uB9C9\uC740
      \uCCB4\uB9AC\uAC00 \uC88B\uACA0\uB2E4. \uC900\uBE44 \uB410\uC9C0\uC774?"
  presentationDialogueSequence:
  - speaker: 0
    line: "\u2026 \u2026 \u2026."
  - speaker: 0
    line: "\uC624\uC624\u2026 \uC774 \uC785\uC548\uC5D0 \uAC10\uB3C4\uB294 \uB2EC\uCF64\uD568.
      \uB0B4\uAC00 \uC120\uD0DD\uD55C \uC870\uD569\uC774 \uAF64 \uC88B\uC740\uB370\u2026.
      \uD478\uD478, \uB108 \uC81C\uBC95\uC774\uB2E4? \uC774\uB807\uAC8C \uB9DB\uC788\uC744
      \uAC70\uB77C\uACE4 \uC608\uC0C1\uD558\uC9C0 \uBABB\uD588\uB294\uB370. \uAC8C\uB2E4\uAC00
      \uC774 \uB098\uBE44\uB294\u2026 \uC124\uB9C8 \uB3C5\uC774 \uC788\uB2E4\uB358\uAC00,
      \uD06C\uD06C."
  - speaker: 0
    line: "\uC815\uC9C1\uD55C \uB108\uB77C\uBA74 \uADF8\uB7EC\uC9C0 \uC54A\uC558\uACA0\uC9C0\uB9CC,
      \uBB3C\uB85C\uC628\u2026. \uC88B\uC544, \uC88B\uC544. \uB354 \uC7AC\uBC0C\uC5B4\uC9C0\uACA0\uB124.
      \uC55E\uC73C\uB85C \uD1A0\uD1A0\uB97C \uB450\uACE0\u2026 \uC6B0\uB9AC \uC0AC\uC774\uC5D0
      \uC5B4\uB5A4 \uC77C\uC774 \uBC8C\uC5B4\uC9C8\uC9C0 \uB9D0\uC774\uC57C~ \uD06C\uD06C."
  - speaker: 1
    line: "\uB2E4 \uBA39\uC5C8\uC73C\uBA74 \uAC00\uC9C0 \uADF8\uB798?"
  - speaker: 0
    line: "\uB9E4\uC815\uD558\uAE34. \uB098\uB3C4 \uB9DE\uC740 \uD3B8\uC5D0 \uD0D5\uD6C4\uB8E8
      \uAC00\uAC8C\uB098 \uC5F4\uC5B4 \uBCFC\uAE4C\u2026 \uD06C\uD06C. \uADF8\uB7FC
      \uC548\uB155\u2026 \uB2EC\uCF64\uD55C \uB77C\uC774\uBC8C \uAD70."

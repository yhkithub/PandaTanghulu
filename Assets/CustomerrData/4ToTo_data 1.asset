  customerName: "\uD1A0\uD1A0"
  customerSprite: {fileID: 21300000, guid: 9571634ed5575014d9a6e432da21914c, type: 3}
  smilingCustomerSprite: {fileID: 21300000, guid: dcf37393cf4feb94892ccbc726459731, type: 3}
  skewerOrder:
  - fruit: 7
  - fruit: 5
  - fruit: 4
  - fruit: 6
  - fruit: 7
  toppingItem: 12
  toppingItemSpriteForHint: {fileID: 21300000, guid: 3bcade197be3eb84fba31bcfb2d5c424, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: e85733b75556680459b0b747eedd7907, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: 6507ddb97ef11c245becb6ef52645be4, type: 3}
  skewerWithToppingSprite: {fileID: 21300000, guid: 341a7e1305e80994cab091af359cbfb3, type: 3}
  sugarBoilingSpeed: 4
  sugarBoilingSuccessZoneWidth: 220
  dialogueSequence:
  - speaker: 0
    line: "\uC9DC\uC794~\u2605 \uD478\uD478 \uC548\uB155, \uC544\uCE68\uBD80\uD130
      \uC18C\uBB38\uC774 \uC790\uC790\uD574\uC11C \uB180\uB7EC \uC654\uC5B4.\uB098\uB294
      \uB204\uAD6C\uBCF4\uB2E4 \uC774\uB7F0 \uC0C8\uB85C\uC6B4 \uC18C\uC2DD\uC5D0
      \uBE60\uB974\uB2C8\uAE4C \uB9D0\uC774\uC9C0~"
    spriteState: 0
  - speaker: 1
    line: "\uC5B4\u2026 \uC5B4, \uD1A0\uD1A0! \uC9C4\uC9DC \uC640\uC92C\uB124? \uACE0,
      \uACE0\uB9C8\uC6CC\u2026 \uB098, \uC544\uC9C1 \uC900\uBE44 \uBD80\uC871\uD55C\uB370
      \uAD1C\uCC2E\uC744\uAE4C?"
    spriteState: 0
  - speaker: 0
    line: "\uD478\uD478\uAC00 \uD55C\uB2E4\uB2C8\uAE4C \uADF8\uB0E5 \uBBFF\uACE0
      \uC654\uC9C0! \uB098, \uD0D5\uD6C4\uB8E8 \uC644\uC804 \uC88B\uC544\uD558\uB2C8\uAE4C!
      \uC6B4\uB3D9\uC774 \uB05D\uB098\uBA74 \uB2F9 \uCDA9\uC804\uC740 \uD544\uC218\uB77C\uAD6C!
      \uC624\uB298 \uCE58\uC5B4\uB9AC\uB529 \uC5F0\uC2B5 \uC9C4\uC9DC \uD798\uB4E4\uC5C8\uAC70\uB4E0~
      \uB2E4\uB9AC\uAC00 \uD6C4\uB4E4\uAC70\uB824\uC11C, \uB108\uC758 \uD0D5\uD6C4\uB8E8\uAC00
      \uD544\uC694\uD574!"
    spriteState: 0
  - speaker: 1
    line: "(\uC2EC\uC7A5\uC774 \uB108\uBB34 \uB6F4\uB2E4. \uC9C4\uC815\uD574, \uD478\uD478!
      \uD3C9\uC18C\uCC98\uB7FC!)"
    spriteState: 0
  - speaker: 0
    line: "\uADFC\uB370, \uAC00\uAC8C \uB418\uAC8C \uADC0\uC5FD\uB2E4? \uD478\uD478
      \uB531 \uB124 \uC2A4\uD0C0\uC77C \uAC19\uC544. \uB530\uB73B\uD558\uACE0 \uB2E4\uC815\uD55C
      \uBD84\uC704\uAE30? \uC5ED\uC2DC  \uB9D8\uC5D0 \uB4E0\uB2E4~\u2665 \uC774\uB7EC\uB2E4
      \uB2E8\uACE8 \uB418\uACA0\uB294\uB370?"
    spriteState: 0
  - speaker: 1
    line: "\uADF8\uB7FC! \uC55E\uC73C\uB85C \uC790\uC8FC \uC624\uBA74 \uB098\uC57C
      \uC88B, \uC544\uB2C8 \uAE30\uC058\uC9C0! \uD1A0\uD1A0\uB294 \uC5B8\uC81C\uB4E0
      \uD658\uC601\uC774\uC57C. \uC5B4\uB5A4 \uAC8C \uBA39\uACE0 \uC2F6\uC5B4?"
    spriteState: 0
  - speaker: 0
    line: "\uC74C~! \uACE0\uBBFC\uB41C\uB2E4~ \uADF8\uB7FC \uB098\uB294, \uC0E4\uC778\uBA38\uC2A4\uCF13\uC73C\uB85C
      \uC2DC\uC791\uD574\uC11C \uB538\uAE30\uB791, \uD30C\uC778\uC560\uD50C, \uD1A0\uB9C8\uD1A0,
      \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9\uC740 \uB2E4\uC2DC \uC0E4\uC778\uBA38\uC2A4\uCF13!
      \uC2DC\uC791\uACFC \uB05D\uC774 \uAC19\uC73C\uBA74 \uAE30\uBD84\uC774 \uC88B\uC544\uC9C0\uB294
      \uBC38\uB7F0\uC2A4\uB2C8\uAE4C\u2605"
    spriteState: 0
  presentationDialogueSequence:
  - speaker: 0
    line: "\uC640~ \uBE44\uC8FC\uC5BC \uC88B\uB2E4! \uAC8C\uB2E4\uAC00 \uC774 \uB05D\uC758
      \uB2F9\uADFC\uC740\u2026 \uB108\uBB34 \uBCC4\uC2A4\uD0C0 \uAC01\uC774\uC796\uC544!
      \uC0AC\uC9C4 \uBA3C\uC800~ \uCC30\uCE75\u2606 \u2026\u2026!? \uD478\uD478,
      \uBB50\uC57C \uC774\uAC70\u2026 \uC9C4\uC9DC \uB108\uBB34 \uB9DB\uC788\uB294\uB370?
      \uC0E4\uC778\uBA38\uC2A4\uCF13\uC740 \uC785\uC5D0\uC11C \uC0B4\uC0B4 \uB179\uACE0,
      \uD1A0\uB9C8\uD1A0\uB294 \uC0C1\uD07C\uD55C\uB370 \uB538\uAE30\uB294 \uB2EC\uCF64\uD574!
      \uC644\uC804 \uBC18\uC804 \uB9E4\uB825! \uC124\uD0D5 \uCF54\uD305\uB3C4 \uB531\uC774\uC57C~
      \uC774\uAC70, \uC5F0\uC2B5 \uB05D\uB098\uACE0 \uBA39\uC73C\uBA74 \uD798\uC774
      200% \uC0DD\uAE38 \uAC83 \uAC19\uC544!"
    spriteState: 0
  - speaker: 1
    line: "\uB9C8, \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uC11C \uB2E4\uD589\uC774\uB2E4\u2026"
    spriteState: 0
  - speaker: 0
    line: "\uC5ED\uC2DC \uB124\uAC00 \uB9CC\uB4E4\uC5B4\uC11C \uB354 \uB9DB\uC788\uB294
      \uAC78\uAE4C? \uD6C4\uD6C4. \uB2E4\uC74C\uC5D4 \uCE58\uC5B4\uB9AC\uB354 \uD300\uC774\uB791
      \uAC19\uC774 \uC62C\uAC8C.  \uBB3C\uB860 \uC774\uB807\uAC8C \uB2E8\uB458\uC774
      \uC788\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC~. \uB2E4\uC74C\uC5D0\uB3C4 \uB098\uB9CC\uC744
      \uC704\uD55C \uC870\uD569 \uAE30\uB300\uD560\uAC8C? \uC57D\uC18D\uC774\uC57C!
      \uADF8\uB7FC \uC548\uB155~ "
    spriteState: 0

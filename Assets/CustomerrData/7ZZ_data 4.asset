  toppingItemSpriteForHint: {fileID: 21300000, guid: 87147efa6ac70f2428b7224c423bf7b4, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: 19809cddc107d324381d6fa51868436a, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: 1008105f3adfc12419dbeea182f2db0f, type: 3}
  skewerWithToppingSprite: {fileID: 21300000, guid: eaa562561aa325847a8f358f0f935a4e, type: 3}
  dialogueSequence:
  - speaker: 0
    line: "\uD478\uD478\uD478\uD478\uD478!! \uD478\uD478 \uC788\uC9C0? \uC788\uC9C0
      \uC788\uC9C0?? \uC624\uB298 \uAC00\uAC8C \uC5F4\uC5C8\uB2E4\uBA70! \uD0D5\uD6C4\uB8E8
      \uD310\uB2E4\uBA70! \uC9C4\uC9DC\uC9C0!? \uAFC8 \uC544\uB2C8\uC9C0!?  \uB0B4
      \uADC0\uC5D0 \uB4E4\uB9B0 \uC18C\uBB38\uC774 \uC774\uB807\uAC8C \uC815\uD655\uD55C
      \uC801\uC740 \uCC98\uC74C\uC774\uC57C! \uC138\uC0C1\uC5D0, \uB300\uB2E8\uD558\uB2E4
      \uCC0D\uCC0D\uC544~!"
  - speaker: 1
    line: "\uD5C9, \uC9C4\uC815\uD574. \uC18C\uBB38\uC5D0 \uBE60\uB978 \uB124\uAC00
      \uC774\uC81C \uC62C \uC904\uC740 \uBAB0\uB790\uB124. \uBC14\uB85C \uC8FC\uBB38\uD560
      \uAC70\uC57C?"
  - speaker: 0
    line: " \uB2F9\uC5F0\uD558\uC9C0! \uB098\uB294 \uC774\uBBF8 \uB9C8\uC74C\uC18D\uC73C\uB85C
      \uC2DC\uBBAC\uB808\uC774\uC158\uC744 \uBC31 \uBC88\uC774\uB098 \uB3CC\uB9AC\uACE0
      \uC654\uB294 \uAC78!  \uC77C\uB2E8 \uAC00\uC7A5 \uC88B\uC740 \uAC74 \uB538\uAE30\uC9C0,
      \uB538\uAE30\uB294 \uD544\uC218, \uD0D5\uD6C4\uB8E8\uC758 \uB300\uBA85\uC0AC!
      \uADF8 \uB2E4\uC74C\uC740\u2026 \uC74C\u2026 \uC5B4\u2026 \uD0A4\uC704? \uC0C1\uD07C\uD558\uB2C8\uAE4C?\u2026\uC544\uB2C8\uB2E4,
      \uC7A0\uAE50\uB9CC! \uAC11\uC790\uAE30\u2026 \uD30C\uC778\uC560\uD50C\uB3C4
      \uB9DB\uC788\uC744 \uAC83 \uAC19\uC740\uB370?"
  - speaker: 1
    line: "\uADF8\uB7FC \uB538\uAE30, \uD0A4\uC704\uB791 \uD30C\uC778\uC560\uD50C\uB85C
      \uC904\uAE4C?"
  - speaker: 0
    line: "\uC7A0\uAE50! \uC544\uB2C8\uC57C!! \uCCB4\uB9AC, \uCCB4\uB9AC\uB97C \uC78A\uACE0
      \uC788\uC5C8\uC5B4! \uB2EC\uCF64\uD558\uACE0, \uC791\uACE0, \uB0B4 \uC785\uC5D0
      \uB531 \uB9DE\uACE0, \uC640, \uC0DD\uAC01\uB9CC \uD574\uB3C4 \uCE68\uC774 \uACE0\uC774\uB294
      \uAC78!"
  - speaker: 1
    line: "\uADF8\uB7FC \uCCB4\uB9AC\uB97C \uCD94\uAC00\u2026"
  - speaker: 0
    line: "\uC7A0\uAE50!! \uC544\uB2C8\uC57C, \uC544\uB2C8\uC57C! \uADF8\uB7EC\uBA74
      \uC870\uD569\uC774 \uB108\uBB34 \uC911\uAD6C\uB09C\uBC29\uC778 \uAC78! \uC138\uC0C1\uC5D0,
      \uADF8\uB7EC\uACE0\uBCF4\uB2C8, \uC791\uC740 \uACFC\uC77C\uC774\uB77C\uBA74
      \uBE14\uB8E8\uBCA0\uB9AC\uB3C4 \uC788\uC5C8\uC9C0! \uB354 \uC0C1\uD07C\uD558\uACE0,
      \uD6CC\uB96D\uD55C \uB9DB, \uBE14\uB8E8\uBCA0\uB9AC! \uC5ED\uC2DC \uB538\uAE30\uB294
      \uB108\uBB34 \uD754\uD558\uC9C0, \uC624\uB298\uC740 \uC624\uB298\uC740, \uD478\uD478\uC758
      \uCCAB \uAC00\uAC8C\uB97C \uC5EC\uB294 \uB0A0\uC778\uB370! \uD2B9\uBCC4\uD55C
      \uB0A0\uC778\uB370!"
  - speaker: 1
    line: "\uB538\uAE30\uB97C \uBE7C\uACE0 \uBE14\uB8E8\uBCA0\uB9AC\uB97C \uB123\uC73C\uBA74
      \uB420\uAE4C?"
  - speaker: 0
    line: "\uC7A0\uAE50! \uC73C\uC73C\uC73C, \uBA38\uB9AC \uBCF5\uC7A1\uD574, \uACFC\uC77C
      \uB108\uBB34 \uB9CE\uC544, \uB2E4 \uBA39\uACE0 \uC2F6\uC9C0\uB9CC \uB108\uBB34
      \uD06C\uACE0\u2026 \uB798! \uADF8\uB807\uB2E4\uBA74 \uC5ED\uC2DC, \uC791\uACE0
      \uB9CE\uC774 \uBA39\uC744 \uC218 \uC788\uB294 \uACFC\uC77C\uB85C \uCC44\uC6B0\uB294
      \uAC8C \uC88B\uACA0\uC9C0!"
  - speaker: 1
    line: "\uC791\uAC8C \uC798\uB77C\uC8FC\uB294 \uBC29\uBC95\uB3C4 \uC788\uAE34
      \uD55C\uB370. \uC5B4\uB5BB\uAC8C \uD560\uB798?"
  - speaker: 0
    line: "\uAD1C\uCC2E\uC544! \uB4DC\uB514\uC5B4 \uC815\uD588\uC73C\uB2C8\uAE4C!
      \uC88B\uC544, \uBE14\uB8E8\uBCA0\uB9AC\uC640 \uCCB4\uB9AC, \uADF8\uB9AC\uACE0
      \uB2E4\uC2DC \uBE14\uB8E8\uBCA0\uB9AC, \uBE14\uB8E8\uBCA0\uB9AC, \uB9C8\uC9C0\uB9C9\uC740
      \uB2E4\uC2DC \uCCB4\uB9AC!\uD6C4\uD6C4, \uC774\uBC88 \uD0D5\uD6C4\uB8E8\uB294
      \uCC0D\uCC0D\uC774 \uB9DE\uCDA4 \uD0D5\uD6C4\uB8E8, \uC138\uC0C1\uC5D0\uC11C
      \uAC00\uC7A5 \uC791\uC740 \uD0D5\uD6C4\uB8E8! \uC9C4\uC9DC \uC9C4\uC9DC \uCD5C\uC885
      \uACB0\uC815!! \uC774\uAC74 \uC774\uC81C \uBABB \uBC14\uAFD4!! \uB9CC\uC57D
      \uBC14\uAFB8\uBA74 \uB0B4 \uC774\uB984\uC744\u2026 \uC5B4\u2026 \uCC0D\uCC0D\uC774
      \uC544\uB2C8\uB77C\uACE0 \uBD80\uB97C \uAC70\uC57C!\uC544\uB2C8, \uC548 \uB3FC.
      \uB0B4 \uC774\uB984\uC740 \uCC0D\uCC0D\uC774\uC57C. \uBC14\uAFB8\uBA74 \uC548
      \uB3FC. \uADF8\uB7EC\uB2C8\uAE4C \uB354 \uBABB \uBC14\uAFD4! \uC774\uAC8C \uC9C4\uC9DC\uC57C!!
      \uC9C4\uC9DC\uC57C \uC9C4\uC9DC\uC57C \uC9C4\uC9DC\uC57C!!"
  - speaker: 1
    line: "\uBE14\uB8E8\uBCA0\uB9AC\uC640 \uCCB4\uB9AC, \uCD5C\uC885, \uCD5C\uC885,
      \uCD5C\uC885 \uACB0\uC815."
  presentationDialogueSequence:
  - speaker: 0
    line: " \u2026\uC544\uC544, \uBC18\uC9DD\uAC70\uB9B0\uB2E4. \uC5ED\uC2DC \uB0B4
      \uACB0\uC815\uC740 \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uC5B4! \uC544\uB2C8, \uD2C0\uB838\uB354\uB77C\uB3C4
      \uC774\uBBF8 \uB9DB\uC788\uC5B4 \uBCF4\uC5EC! \uB098 \uC9C4\uC9DC \uAC10\uB3D9\uD588\uC5B4,
      \uC774\uAC70, \uC774\uAC70\u2026 \uB0B4 \uD600\uC5D0\uC11C \uACF5\uC5F0\uC774
      \uD3BC\uCCD0\uC9C4\uB2E4! \uC774 \uCE58\uC988\uB294 \uB610 \uBB50\uC57C! \uB108\uBB34
      \uC13C\uC2A4 \uB9CC\uC810\uC774\uC796\uC544!\uC73C\uC544\uC544, \uBE14\uB8E8\uBCA0\uB9AC\uC640
      \uCCB4\uB9AC\uAC00 \uC190\uC744 \uC7A1\uACE0 \uCDA4\uCD94\uACE0, \uB9C8\uC9C0\uB9C9\uC5D0\uB294
      \uC8FC\uC778\uACF5\uC778 \uCE58\uC988\uAC00 \uB4F1\uC7A5\uD558\uACE0\u2026\uB0B4
      \uC785\uC548\uC774 \uADF9\uC7A5\uC774\uB2E4!! \uC5ED\uC2DC \uC548\uB418\uACA0\uB2E4,
      \uC548\uB418\uACA0\uC5B4, \uC774 \uB9DB\uC744 \uB354 \uB9CE\uC740 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C
      \uC54C\uB824\uC57C\uACA0\uC5B4, \uADF8\uB7FC \uC774\uB9CC!"
  - speaker: 0
    line: "\uB2E4\uC2DC \uC62C \uAC70\uC57C!! \uB0B4 \uBE14\uB8E8\uBCA0\uB9AC, \uCCB4\uB9AC
      \uBAAB \uB0A8\uACA8 \uB46C!"

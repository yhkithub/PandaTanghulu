  customerName: "\uBB49\uBB49"
  customerSprite: {fileID: 21300000, guid: c4205a2848e20764fa3e4329ec3c966a, type: 3}
  smilingCustomerSprite: {fileID: 5740082424756886293, guid: 44586ec0358afc646a594d998f24950e, type: 3}
  skewerOrder:
  - fruit: 1
  - fruit: 3
  - fruit: 1
  - fruit: 3
  toppingItem: 10
  toppingItemSpriteForHint: {fileID: 21300000, guid: 98f5a83c8af318a489812bc22fbb000d, type: 3}
  completedSkewerSprite: {fileID: 21300000, guid: 7a8e9d557139d02489e055388676f785, type: 3}
  sugarCoatedSkewerSprite: {fileID: 1288084061216479992, guid: 8531a45a1696e634181908fd66b45e49, type: 3}
  skewerWithToppingSprite: {fileID: -4585161123306608184, guid: 6c58ea8935f1a2b459aa63e1530838ea, type: 3}
  sugarBoilingSpeed: 2
  sugarBoilingSuccessZoneWidth: 300
  dialogueSequence:
  - speaker: 0
    line: "\uD478\uD478 \uD615~!! \uD788\uD788, \uB098 \uC654\uC5B4~ \uC5B4\uC81C
      \uAFC8\uC5D0\uC11C \uD478\uD478 \uD615\uC774 \uB9CC\uB4E0 \uD0D5\uD6C4\uB8E8\uAC00
      \uB098\uC654\uB294\uB370\u2026\uADF8\uB798\uC11C, \uC77C\uC5B4\uB098\uC790\uB9C8\uC790
      \uB2EC\uB824\uC654\uC9C0! \uBC30\uACE0\uD30C\uC11C~ \uC751~\r\n"
    spriteState: 0
  - speaker: 1
    line: "\uBB49\uBB49, \uC5B4\uC81C\uB3C4 \uAFC8\uC5D0\uC11C \uD0D5\uD6C4\uB8E8\uB97C
      \uBD24\uB2E4\uACE0? \uB610 \uD0D5\uD6C4\uB8E8 \uAFC8 \uAFBC \uAC70\uC57C?"
    spriteState: 0
  - speaker: 0
    line: "\uC751~ \uC774\uBC88\uC5D4 \uD558\uB298\uC5D0\uC11C \uB5A8\uC5B4\uC84C\uC5B4~
      \uD0D5\uD6C4\uB8E8\uAC00 \uB9C9 \uBE44\uCC98\uB7FC~\uADFC\uB370 \uB0B4\uAC00
      \uB108\uBB34 \uB290\uB824\uC11C \uD55C \uAC1C \uBC16\uC5D0 \uBABB \uBA39\uC5C8\uC9C0
      \uBB50\uC57C~\uADF8\uB798\uC11C \uC624\uB298\uC740 \uB290\uB9AC\uC9C0 \uC54A\uAC8C,
      \uBE60\uB974\uAC8C \uC654\uC5B4! \uC81C\uC77C \uBA3C\uC800 \uBA39\uC73C\uB824\uACE0~"
    spriteState: 0
  - speaker: 1
    line: "\uD558\uD558, \uADF8\uB798. \uC798 \uC654\uC5B4. \uBB49\uBB49. \uC5B4\uB5A4
      \uAC70 \uBA39\uC744\uB798?"
    spriteState: 0
  - speaker: 0
    line: "\uC74C~ \uD0D5\uD6C4\uB8E8\uB294 \uB2E4 \uC88B\uC740\uB370~ \uB2EC\uCF64\uD558\uACE0,
      \uBC18\uC9DD\uAC70\uB9AC\uACE0, \uAFC0\uCC98\uB7FC \uB9DB\uC788\uACE0\u2026.\uADFC\uB370
      \uC624\uB298\uC740~ \uC5B4\uCA50\uC9C0 \uADE4\uC774\uB791 \uD0A4\uC704\uAC00
      \uB2F9\uAE30\uB124! \uB450 \uAC1C\uB294 \uB108\uBB34 \uB9CE\uC73C\uB2C8\uAE4C\u2026
      \uC73C\uC74C\u2026\uADE4\uACFC \uD0A4\uC704\uB97C \uBC88\uAC08\uC544\uC11C
      \uB07C\uC6CC\uC904\uB798~? \uC0AC\uC2E4 \uD478\uD478 \uD615\uC774 \uB9DB\uC788\uAC8C
      \uB9CC\uB4E4\uC5B4 \uC8FC\uBA74 \uBB50\uB4E0\uC9C0 \uC88B\uC9C0\uB9CC~ \uD5E4\uD5E4~"
    spriteState: 0
  presentationDialogueSequence:
  - speaker: 0
    line: "\uC73C\uC73C\uC74C\u2026 \uB9DB\uC788\uC5B4\u2026 \uB2EC\uCF64\uD558\uACE0\u2026
      \uD0A4\uC704\uC640 \uADE4\uC758 \uC870\uD569\uC740 \uC5ED\uC2DC \uC88B\uB2E4\uB2C8\uAE4C!
      \uCFE0\uD0A4\uB3C4 \uB123\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC~\uB2E8\uB9DB\uACFC
      \uC2E0\uB9DB\uC774 \uBC88\uAC08\uC544 \uB098\uC624\uBA74\uC11C\u2026 \uD478\uD478
      \uD615\u2026 \uCD5C\uACE0\uC57C\u2026 \uC815\uB9D0 \uCD5C\uACE0\uC57C\u2026!
      \uD615\uC740\u2026 \uD0D5\uD6C4\uB8E8 \uCC9C\uC7AC\u2026 \uC544\uB2C8\u2026
      \uD0D5\uD6C4\uB8E8 \uC655\u2026 \uC544\uB2C8\u2026 \uD0D5\uD6C4\uB8E8 \uC2E0\u2026!\r\n"
    spriteState: 0
  - speaker: 1
    line: "\uACFC\uC7A5\uC774 \uC810\uC810 \uC2EC\uD574\uC9C0\uB294\uB370\u2026?
      \uADF8\uB798\uB3C4 \uACE0\uB9C8\uC6CC, \uBB49\uBB49. \uAE30\uBD84 \uC88B\uC544\uC9C4\uB2E4!"
    spriteState: 0
  - speaker: 0
    line: "\uB098 \uC9C4\uC9DC \uD589\uBCF5\uD574~ \uC9C0\uAE08 \uB9DB \uBCF8 \uC774
      \uB9DB\uC744 \uC790\uAE30 \uC804\uAE4C\uC9C0 \uC78A\uC9C0 \uC54A\uC558\uC73C\uBA74
      \uC88B\uACA0\uB2E4~\u2026\uB0B4\uC77C \uB610 \uC640\uB3C4 \uB3FC? \uD615\uC774
      \uB9CC\uB4E0 \uAC70, \uB9E4\uC77C \uBA39\uACE0 \uC2F6\uC5B4\u2026 \uB9E4\uC77C~
      \uB9E4\uC77C~"
    spriteState: 0
  - speaker: 1
    line: "\uADF8\uB7FC, \uBB3C\uB860\uC774\uC9C0~ \uB0B4\uC77C \uBCF4\uC790!"
    spriteState: 1

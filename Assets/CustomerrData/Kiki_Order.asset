  customerName: kiki
  customerSprite: {fileID: 21300000, guid: 0c1af4f2557c64a4d91eee4df5a02b54, type: 3}
  skewerOrder:
  - fruit: 1
  - fruit: 1
  - fruit: 1
  toppingItem: 2
  toppingItemSpriteForHint: {fileID: 0}
  completedSkewerSprite: {fileID: 21300000, guid: 19809cddc107d324381d6fa51868436a, type: 3}
  sugarCoatedSkewerSprite: {fileID: 21300000, guid: 1008105f3adfc12419dbeea182f2db0f, type: 3}
  dialogueSequence:
  - speaker: 0
    line: "\r\uD478\uD478~!! \uC5EC\uAE30 \uB9DE\uC9C0?! \uC6B0\uC640, \uC9C4\uC9DC
      \uAC00\uAC8C\uAC00 \uC0DD\uACBC\uB124!! \uAC04\uD310\uB3C4 \uADC0\uC5FD\uACE0,
      \uB0C4\uC0C8\uB3C4 \uC644\uC804 \uCD5C\uACE0\uACE0\u2026 \uC73C\uC544\uC544,
      \uC9C0\uAE08 \uCE68\uC774 \uACE0\uC774\uB294 \uC911\uC774\uC57C!!\r\n\r"
  - speaker: 1
    line: "\uB07C\uB07C~ \uC640\uC918\uC11C \uACE0\uB9C8\uC6CC. \uC624\uB298 \uD559\uAD50
      \uB05D\uB098\uC790\uB9C8\uC790 \uBC14\uB85C \uC628 \uAC70\uC57C?\r"
  - speaker: 0
    line: "\uADF8\uB798! \uC218\uC5C5 \uB05D\uB098\uC790\uB9C8\uC790 \uAC00\uBC29\uC744
      \uB4E4\uACE0 \uB0C5\uB2E4 \uB2EC\uB824\uC654\uC9C0! \uBB3C\uB860 \uC624\uBA74\uC11C
      \uB3CC\uBD80\uB9AC\uC5D0 \uB450 \uBC88, \uD06C\uD06C\uC5D0 \uD55C \uBC88 \uAC78\uB824\uC11C
      \uB118\uC5B4\uC9C8 \uBED4 \uD588\uC9C0\uB9CC\u2026\uD478\uD478\uC758 \uD0D5\uD6C4\uB8E8
      \uAC00\uAC8C\uC758 \uCCAB \uC190\uB2D8 \uC790\uB9AC\uB97C \uB193\uCE60 \uC218\uB294
      \uC5C6\uC5C8\uC5B4!"
  - speaker: 1
    line: "\uD558\uD558, \uB2E4\uCE58\uC9C4 \uC54A\uC558\uC9C0? \uADF8\uB807\uAC8C
      \uAE09\uD558\uAC8C \uC628 \uAC70 \uBCF4\uB2C8\uAE4C, \uAF64 \uAE30\uB300\uD558\uACE0
      \uC788\uC5C8\uB098 \uBD10!"
  - speaker: 0
    line: "\uB2F9\uC5F0\uD558\uC9C0!! \uD478\uD478\uAC00 \uC9C1\uC811 \uB9CC\uB4E0
      \uAC00\uAC8C\uC5D0, \uD0D5\uD6C4\uB8E8\uC796\uC544?! \uC5BC\uB9C8\uB098 \uAE30\uB2E4\uB838\uB294\uC9C0
      \uD478\uD478\uB294 \uBAA8\uB97C \uAC70\uC57C! \uADFC\uB370, \uB2E4 \uB9DB\uC788\uC5B4
      \uBCF4\uC5EC\uC11C \uACE0\uBBFC\uB41C\uB2EC\uAE4C. \uBC14\uB098\uB098\uAC00
      \uC5C6\uB294 \uAC8C \uC870\uAE08 \uC544\uC27D\uC9C0\uB9CC\u2026 \uC73C\uC544,
      \uC65C \uC774\uB807\uAC8C \uACE0\uB974\uAE30 \uC5B4\uB835\uAC8C \uB9CC\uB4E4\uC5B4
      \uB1A8\uC5B4!?"
  - speaker: 1
    line: "\uC74C, \uADF8\uB7FC \uB0B4 \uCD94\uCC9C \uC870\uD569\uC740 \uC5B4\uB54C?
      \uC544\uBB34\uB798\uB3C4 \uC815\uC11D\uC740 \uBAA8\uB450 \uAC19\uC740 \uACFC\uC77C\uB85C
      \uD1B5\uC77C\uD574\uC11C \uBA39\uB294 \uAC70\uC9C0! \uCCAB \uC190\uB2D8\uC774\uB2C8\uAE4C
      \uD2B9\uBCC4\uD788 \uB0B4\uAC00 \uD1B5\uADE4\uB85C \uAC00\uB4DD \uCC44\uC6CC\uC11C
      \uC904\uAC8C."
  - speaker: 0
    line: "\uC624\uC624\uC624! \uADF8\uAC70 \uC644\uC804 \uBE44\uD0C0\uBBFC \uD3ED\uBC1C
      \uC870\uD569\uC774\uC796\uC544!! \uC88B\uC544! \uD1B5\uADE4 4\uAC1C\uB85C \uAF49
      \uCC44\uC6CC\uC918! \uC774\uB984\uC740\u2026 \uB07C\uB07C \uC5D0\uB108\uC9C0
      \uD3ED\uBC1C \uD0D5\uD6C4\uB8E8\uB85C \uD558\uC790!"
